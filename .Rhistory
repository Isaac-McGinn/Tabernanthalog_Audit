#load packages
library(tidyverse)
library(pzfx)
library(here)
#import raw data using 'here()' to find project root
raw_data <- read_pzfx(
here("data/raw/extracted/Final Data for Publication/Fig 4e_Alcohol over time copy.pzfx"),
table = "Data 1"
)
#print raw dimensions to verify import
dim(raw_data)
#- 3 rows, 39 columns
#preview raw_data
glimpse(raw_data)
#observations:
#- 3 rows, 39 columns (wide data frame)
#- no "NA" values
#- all values <dbl>
#- column: "ROWTITLE" contains time points "1, 2, 5"
#- 38 columns represent indiv mice replicates "VEH_n" & "TBG_n" (where 1<=n<=19)
#- mice columns contain daily alcohol intake (g/kg) data
#tidy based on observations
tidy_data <- raw_data |>
pivot_longer(
cols = -ROWTITLE,
names_to = "mice_replicates",
values_to = "alcohol_intake"
) |>
#rename column containing time points
rename(day = ROWTITLE) |>
#split column "mice_replicates"
separate_wider_delim(
cols = mice_replicates,
delim = "_",
names = c("treatment", "mouse_id")
) |>
#change variable type to: treatment <fct> & mouse_id <int>
mutate(
treatment = as.factor(treatment),
mouse_id = as.integer(mouse_id)
)
#check to see that changes were made
head(tidy_data, 5) |>
knitr::kable(caption = "Wrangled Long-Format (Tidy) Data Preview")
#fit 2-way repeated measures ANOVA test
anova_model <- aov(
alcohol_intake ~ treatment * as.factor(day) +
Error(as.factor(mouse_id)),
data = tidy_data
)
#print model
broom::tidy(anova_model) |>
knitr::kable(digits = 4, caption = "2-Way Repeated Measures ANOVA")
#load packages
library(tidyverse)
library(pzfx)
library(here)
#import raw data using 'here()' to find project root
raw_data <- read_pzfx(
here("data/raw/extracted/Final Data for Publication/Fig 4e_Alcohol over time copy.pzfx"),
table = "Data 1"
)
#print raw dimensions to verify import
dim(raw_data)
#- 3 rows, 39 columns
#preview raw_data
glimpse(raw_data)
#observations:
#- 3 rows, 39 columns (wide data frame)
#- no "NA" values
#- all values <dbl>
#- column: "ROWTITLE" contains time points "1, 2, 5"
#- 38 columns represent indiv mice replicates "VEH_n" & "TBG_n" (where 1<=n<=19)
#- mice columns contain daily alcohol intake (g/kg) data
#tidy based on observations
tidy_data <- raw_data |>
pivot_longer(
cols = -ROWTITLE,
names_to = "mice_replicates",
values_to = "alcohol_intake"
) |>
#rename column containing time points
rename(day = ROWTITLE) |>
#split column "mice_replicates"
separate_wider_delim(
cols = mice_replicates,
delim = "_",
names = c("treatment", "mouse_id")
) |>
#change variable type to: treatment <fct> & mouse_id <int>
mutate(
treatment = as.factor(treatment),
mouse_id = as.integer(mouse_id)
)
#check to see that changes were made
head(tidy_data, 5) |>
knitr::kable(caption = "Wrangled Long-Format (Tidy) Data Preview")
#| fig-width: 6
#| fig-height: 4.5
#| out-width: "80%"
#| fig-align: "center"
#group and summarize data
summary_data <- tidy_data |>
group_by(day, treatment) |>
summarise(
mean_intake = mean(alcohol_intake),
sd_intake = sd(alcohol_intake),
n = n(),
sem_intake = sd_intake / sqrt(n)
) |>
ungroup()
#check changes
print(summary_data)
#- changes made
#replicate figure using summary_data
replication_plot <- ggplot(
summary_data,
aes(
x = as.factor(day),
y = mean_intake,
group = treatment,
fill = treatment,
color = treatment
)
) +
#treatment lines
geom_line(
linewidth = 1
) +
#SEM error bars
geom_errorbar(
aes(
ymin = mean_intake - sem_intake,
ymax = mean_intake + sem_intake
),
width = .1,
linewidth = .8
) +
#filled points
geom_point(
shape = 21,
size = 4,
color = "black",
stroke = 1
) +
#color mapping
scale_fill_manual(values = c("VEH" = "white",
"TBG" = "steelblue")) +
scale_color_manual(values = c("VEH" = "black",
"TBG" = "steelblue")) +
#add signif * (assumed signif at this point)
annotate(
geom = "text",
x = c(1, 2),
y = c(12.5, 13.5),
label = c("***", "*"),
size = 6,
color = "black"
) +
#zooming without cut off error bars
coord_cartesian(
ylim = c(0, 15)) +
scale_y_continuous(
breaks = seq(0, 15, 5)) +
#add labels
labs(
x = "Days",
y = "Alcohol Intake (g/kg/day)",
title = "Recreation of Figure 4e"
) +
theme_classic()
#| label: check-original-image
#| echo: false
# Check original figure asset exists in local directory
has_original_image <- file.exists("published_figure_4e.png")
#| label: side-by-side-open
#| echo: false
#| eval: !expr has_original_image
#| results: 'asis'
cat("::: {layout-ncol=2}\n")
#| label: plot-recreation-side
#| echo: false
#| eval: !expr has_original_image
#| fig-width: 6
#| fig-height: 4.5
print(replication_plot)
#fit 2-way repeated measures ANOVA test
anova_model <- aov(
alcohol_intake ~ treatment * as.factor(day) +
Error(as.factor(mouse_id)),
data = tidy_data
)
#print model
broom::tidy(anova_model) |>
#force scientific notation when p value is low to avoid rounding to .0000
mutate(p.value = ifelse(p.value < 0.001,
format(p.value, scientific = TRUE, digits = 4),
format(round(p.value, 4), nsmall = 4))) |>
knitr::kable(digits = 4, caption = "2-Way Repeated Measures ANOVA")
